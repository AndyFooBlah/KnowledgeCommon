{
  "name": "@andyfooblah/knowledge-common",
  "version": "1.3.1",
  "description": "General-purpose knowledge and utility tools for AI agents powered by Google Gemini.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AndyFooBlah/KnowledgeCommon.git"
  },
  "homepage": "https://github.com/AndyFooBlah/KnowledgeCommon#readme",
  "bugs": {
    "url": "https://github.com/AndyFooBlah/KnowledgeCommon/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/lib.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/lib.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "scripts": {
    "build:lib": "vite build --config vite.lib.config.ts && node scripts/check-bundle-for-secrets.mjs",
    "check:bundle": "node scripts/check-bundle-for-secrets.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "type-check": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "check:models": "node scripts/check-models.mjs"
  },
  "peerDependencies": {
    "@google/genai": "^1.0.0 || ^2.0.0",
    "firebase": "^12.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@google/genai": "^2.31.0",
    "firebase": "^13.1.0",
    "@types/node": "^26.6.5",
    "@typescript-eslint/eslint-plugin": "^8.58.0",
    "@typescript-eslint/parser": "^8.58.0",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "typescript": "~5.8.2",
    "vite": "^8.1.5",
    "vite-plugin-dts": "^5.0.1",
    "vitest": "^5.0.0"
  }
}
